PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database configuration (Docker mapped port 5435)
DATABASE_URL="postgresql://worktrackr:worktrackr_password@localhost:5435/worktrackr_db?schema=public"

# JWT Secrets
JWT_ACCESS_SECRET="worktrackr_jwt_access_super_secret_key_2026_!@#"
JWT_REFRESH_SECRET="worktrackr_jwt_refresh_super_secret_key_2026_!@#"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cookie Security (false in dev for localhost http)
COOKIE_SECURE=false
